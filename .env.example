# Docker Compose local configuration. Copy this file to .env before startup.

# Loopback-only host ports
FRONTEND_PORT=3000
BACKEND_PORT=5000

# Required local secrets. Replace both placeholders before starting Compose.
SECRET_KEY=replace-me
JWT_SECRET_KEY=replace-me-with-a-different-value

# Ollama remains on the WSL host and is not a Compose service.
OLLAMA_HOST=http://host.docker.internal:11434
LLM_MODEL=qwen3:8b

# Browser-facing local URLs
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
