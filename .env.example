# Docker Compose local defaults. Copy to .env only when overrides are needed.

# Loopback-only host ports
FRONTEND_PORT=3000
BACKEND_PORT=5000

# Replace these placeholders for any environment beyond a local demo.
SECRET_KEY=replace-with-a-random-secret
JWT_SECRET_KEY=replace-with-a-different-random-secret

# Ollama remains on the WSL host and is not a Compose service.
OLLAMA_HOST=http://host.docker.internal:11434
LLM_MODEL=qwen3:8b

# Browser-facing local URLs
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
