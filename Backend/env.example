# XU-News-AI-RAG Backend Environment Variables Configuration
# Copy this file to .env and modify the configuration as needed

# ===== Flask Application Configuration =====
FLASK_ENV=development
# Use a randomly generated secret key in production
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-in-production
DEBUG=True

# ===== Database Configuration =====
# SQLite (default)
DATABASE_URL=sqlite:///data/sqlite/knowledge.db
# PostgreSQL (recommended for production)
# DATABASE_URL=postgresql://username:password@localhost:5432/xu_news_db

# ===== JWT Authentication Configuration =====
# Use a randomly generated secret key in production
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=jwt-secret-key-change-in-production
# Token expiration time in seconds (24 hours)
JWT_ACCESS_TOKEN_EXPIRES=86400
# Refresh token expiration time in seconds (7 days)
JWT_REFRESH_TOKEN_EXPIRES=604800

# ===== CORS Configuration =====
# Separate multiple origins with commas
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===== Redis Configuration =====
REDIS_URL=redis://localhost:6379/0
# Redis with password
# REDIS_URL=redis://:password@localhost:6379/0

# ===== Celery Task Queue Configuration =====
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ===== Ollama LLM Configuration =====
# Ollama server URL (default port 11434)
OLLAMA_HOST=http://localhost:11434
# Ollama model name (download with: ollama pull qwen3:8b)
LLM_MODEL=qwen3:8b

# ===== AI Model Configuration (本地离线模式) =====
# 注意: 所有模型使用本地缓存，不会联网下载
# 模型缓存目录: ~/.cache/huggingface/hub
# 首次使用前请确保已下载模型到缓存目录

# Embedding model for vectorization (384 dimensions)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Rerank model for result optimization
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# 模型缓存目录（可选，默认为 ~/.cache/huggingface/hub）
# MODEL_CACHE_DIR=/path/to/your/model/cache

# ===== FAISS Vector Database Configuration =====
FAISS_INDEX_PATH=data/faiss/knowledge.index
FAISS_ID_MAPPING_PATH=data/faiss/id_mapping.json
VECTOR_DIMENSION=384

# ===== File Upload Configuration =====
# Maximum file size in bytes (16MB = 16 * 1024 * 1024)
MAX_CONTENT_LENGTH=16777216
# Upload directory (will be created automatically)
UPLOAD_FOLDER=data/uploads

# ===== Text Processing Configuration =====
# Maximum text length for processing (characters)
MAX_TEXT_LENGTH=512

# ===== Search Configuration =====
# Enable search result caching
SEARCH_CACHE_ENABLED=true
# Cache time-to-live in seconds (1 hour)
SEARCH_CACHE_TTL=3600

# ===== RAG Configuration =====
# Default number of documents to retrieve initially
RAG_DEFAULT_TOP_K=20
# Number of documents to return after reranking
RAG_RERANK_TOP_K=5
# Maximum context length for LLM input
RAG_MAX_CONTEXT_LENGTH=4000
# Enable result reranking
RAG_ENABLE_RERANK=true
# Enable web search fallback when no local results found
RAG_ENABLE_WEB_FALLBACK=false

# ===== LLM Generation Configuration =====
# Maximum tokens for LLM response
LLM_MAX_TOKENS=2048
# LLM temperature (creativity level, 0.0-1.0)
LLM_TEMPERATURE=0.7

# ===== Web Crawler Configuration =====
# User agent string for web requests
CRAWLER_USER_AGENT=Mozilla/5.0 (compatible; XU-News-Bot/1.0)
# Request timeout in seconds
CRAWLER_TIMEOUT=10
# Maximum retry attempts for failed requests
CRAWLER_MAX_RETRIES=3
# Delay between requests in seconds (be respectful to servers)
CRAWLER_DELAY=1

# ===== Email Configuration =====
# SMTP server configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
# SMTP username for authentication
SMTP_USERNAME=your-email@gmail.com
# SMTP password or app password
SMTP_PASSWORD=your-app-password
# Default sender email address
FROM_EMAIL=noreply@xu-news-rag.com
# Default sender name
FROM_NAME=XU News AI RAG

# ===== Frontend Configuration =====
# Frontend application URL
FRONTEND_URL=http://localhost:3000

# ===== Logging Configuration =====
LOG_LEVEL=INFO
# Log file path
# LOG_FILE=logs/app.log

# ===== API Rate Limiting Configuration (Optional) =====
# RATELIMIT_ENABLED=True
# RATELIMIT_DEFAULT=100 per hour

# ===== External Search API Configuration (Optional) =====
# For web search fallback when no local results found
# SERPER_API_KEY=your-serper-api-key
# BING_SEARCH_API_KEY=your-bing-api-key
# GOOGLE_CUSTOM_SEARCH_API_KEY=your-google-api-key
# GOOGLE_CUSTOM_SEARCH_ENGINE_ID=your-search-engine-id

# ===== Other Configuration =====
# Timezone setting
TIMEZONE=Asia/Shanghai
# Default language
DEFAULT_LANGUAGE=zh
