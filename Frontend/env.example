# ===========================================
# RAG News Intelligence Platform - 前端环境变量配置
# ===========================================

# API 配置
# Leave unset to use the same-origin /api proxy in Vite and Caddy.
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT=10000

# 应用配置
VITE_APP_TITLE=RAG News Intelligence Platform
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=基于 AI 的新闻知识库检索系统

# 开发配置
VITE_DEV_PORT=3000
VITE_DEV_HOST=localhost

# 功能开关
VITE_ENABLE_MOCK=false
VITE_ENABLE_DEBUG=false

# 主题配置
VITE_DEFAULT_THEME=light
VITE_THEME_PERSIST=true
