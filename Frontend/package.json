{
  "name": "xu-news-ai-rag-frontend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix --ignore-path .gitignore",
    "test": "vitest run tests/",
    "test:all": "vitest run tests/",
    "test:unit": "vitest run",
    "test:unit:all": "vitest run tests/unit",
    "test:integration": "vitest run",
    "test:integration:all": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:e2e:check": "node tests/e2e/check-services.js",
    "test:e2e:setup": "node tests/e2e/setup-test-data.js",
    "test:performance": "vitest run",
    "test:performance:all": "vitest run tests/performance",
    "test:security": "vitest run",
    "test:security:all": "vitest run tests/security",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage tests/"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.6.2",
    "dompurify": "^3.2.7",
    "element-plus": "^2.4.4",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.0",
    "pinia": "^2.1.7",
    "pinia-plugin-persistedstate": "^3.2.1",
    "vue": "^3.4.0",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.5.2",
    "@vitest/coverage-v8": "^1.6.1",
    "@vue/test-utils": "^2.4.0",
    "eslint": "^8.55.0",
    "eslint-plugin-vue": "^9.19.2",
    "jsdom": "^23.0.0",
    "vite": "^5.0.8",
    "vitest": "^1.6.1"
  }
}
